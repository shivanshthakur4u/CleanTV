{
  "name": "tv-home-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "node -e \"console.info('[DEBUG-vercel-entry] Fastify entry: src/server.ts; function overrides disabled')\" && tsc --noEmit && tsc",
    "start": "node --env-file=.env dist/server.js",
    "migrate": "tsx --env-file=.env src/migrate.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
