PORT=8080
HOST=127.0.0.1
DATABASE_URL=postgresql://tvhome:change-this-password@127.0.0.1:5432/tvhome
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
AUTH_AUDIENCE=authenticated
# Use verify-full and a trusted CA for a remote PostgreSQL server.
# For a Supabase URI, use sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt.
PGSSLMODE=disable
# Leave false unless a trusted reverse proxy is the only route to this service.
TRUST_PROXY=false
